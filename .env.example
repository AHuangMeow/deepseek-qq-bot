# ============ 必填 ============
# DeepSeek API Key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# NapCat WebUI 登录口令（自己生成一个长随机串）
WEBUI_TOKEN=change-me-to-a-long-random-token

# ============ NapCat / OneBot ============
# 与 compose.yaml 中映射的 3001 端口对应
NAPCAT_WS_URL=ws://127.0.0.1:3001
# 如果你在 NapCat WebUI 里给正向 WS 设置了 token，就填在这里；否则留空
NAPCAT_WS_TOKEN=
# Docker 容器以当前用户身份运行（一般无需修改）
NAPCAT_UID=1000
NAPCAT_GID=1000

# ============ DeepSeek ============
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TEMPERATURE=1.1
DEEPSEEK_MAX_TOKENS=320
DEEPSEEK_TIMEOUT=60
# 关闭思考模式：QQ 聊天要快，回复也更短；需要更强推理可改 true
DEEPSEEK_THINKING=false

# ============ 图片识别（DeepSeek 视觉） ============
# 收到图片后先让 DeepSeek 生成一句描述，再把描述交给 Kev 判断是否回复
VISION_ENABLED=true
VISION_CAPTION_FOR_KEV=true
# low 更省 token；想看细节可改 high
VISION_DETAIL=low
# 单条消息最多处理几张图
MAX_IMAGES_PER_MESSAGE=3
# 单张图片最大字节数（DeepSeek 上限 32MiB，这里保守一点）
MAX_IMAGE_BYTES=20971520
IMAGE_DOWNLOAD_TIMEOUT=20
# 已经看过的图片在内存里保留多久，方便追问
IMAGE_CACHE_SECONDS=600
# 最终回复时最多再带上最近几张历史图片
MAX_CONTEXT_IMAGES=2

# ============ Kev 本地判断模型 ============
KEV_ENABLED=true
KEV_BASE_URL=http://127.0.0.1:8009
KEV_PORT=8009
KEV_API_KEY=
KEV_MODEL=kev-latest
KEV_TIMEOUT=20
KEV_DEVICE=auto
# 官方模型仓库；8GB 显存推荐 0.8B
KEV_MODEL_REPO=jaredpalmer/kev-0.8b

# 三条阈值：Kev 给出的“应该回复”概率达到阈值才回复
# 被 @ / 私聊时故意放低，仍然由 Kev 判断，只是很少否决
KEV_REPLY_THRESHOLD_AT=0.20
KEV_REPLY_THRESHOLD_PRIVATE=0.20
# 群聊普通消息（没 @ 机器人）的插话阈值，越高越安静
KEV_REPLY_THRESHOLD_GROUP=0.72
# 风险概率达到该值时，不管是否被 @ 都不回复
KEV_RISK_THRESHOLD=0.60
# Kev 挂掉时是否放行（false = 宁可沉默，符合“全部交给 Kev 判断”）
KEV_FAIL_OPEN=false

# ============ 机器人 ============
BOT_NAME=小深
# 逗号分隔的别名，群聊里出现这些词会视为在叫机器人
BOT_ALIASES=小深,deepseek,ds
PERSONA_FILE=persona.md

# 管理员 QQ（逗号分隔），用于 !status / !reset；留空则没人能执行管理命令
ADMIN_QQS=

# 群/私聊白名单：留空表示不限制。格式：123456,789012
GROUP_WHITELIST=
PRIVATE_WHITELIST=
# 黑名单优先级高于白名单
GROUP_BLACKLIST=
PRIVATE_BLACKLIST=

# 是否允许机器人在没被 @ 的群聊里接话
ENABLE_AMBIENT=true
# 群聊普通消息的冷却（秒），仅限制主动接话；被 @ 不受影响
GROUP_COOLDOWN_SECONDS=25
# 同一个用户主动接话的冷却（秒）
USER_COOLDOWN_SECONDS=90
# 每分钟全局最多发送多少条机器人消息
MAX_REPLIES_PER_MINUTE=8
# 机器人连续发言达到该数量后，暂停主动接话
MAX_BOT_MESSAGES_IN_ROW=2

# 收到消息后等待一小会儿再判断，合并连发消息（秒）
DEBOUNCE_SECONDS=0.8
# 提供给 Kev / DeepSeek 的最近消息条数（Kev-0.8B 不建议给太长）
MAX_CONTEXT_MESSAGES=10
# 单条回复最大字符数
MAX_REPLY_CHARS=320
# 群聊回复时是否 @ 对方
MENTION_ON_REPLY=true
# 是否引用原消息
QUOTE_REPLY=false

# ============ 表情包 ============
STICKER_ENABLED=true
# 表情包目录；支持 jpg/jpeg/png/gif/webp
STICKER_DIR=~/Downloads/表情包
# 每条回复附表情包的概率（0~1）；所有语气都可能触发，playful 概率略高
STICKER_CHANCE=0.2
STICKER_MAX_BYTES=8388608
# 文件名包含这些词的表情包不会自动发送（逗号分隔）
STICKER_BLOCK_WORDS=杀,死,妈,草,怒,笨蛋,傻,滚,屎,尿,裸,色,性,黄,毒,枪,刀,普信

# 只记录决策、不真正发消息（调试用）
DRY_RUN=false
# 是否把每次 Kev 判断写入 data/decisions.jsonl，方便以后调阈值/微调
DECISION_LOG=true
LOG_LEVEL=INFO
